<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight">
        <item name="android:statusBarColor">#F5F6FA</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="CustomAlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">#FFFFFF</item> <!-- Цвет акцента (для кнопок) -->
        <item name="android:textStyle">bold</item>
        <item name="android:windowBackground">@drawable/dialog_background</item> <!-- Фон диалога -->
        <item name="android:textColor">#000000</item> <!-- Основной цвет текста -->
        <item name="android:textSize">16sp</item> <!-- Размер текста -->
    </style>

</resources>