<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ТВОЙ ТЕКУЩИЙ ДИЗАЙН (ГЛАВНЫЙ ЭКРАН) -->
    <LinearLayout
        android:id="@+id/homeContainer"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_navigation"
        android:layout_alignParentTop="true"
        android:padding="24dp">

        <TextView
            android:text="@string/scripto"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="40dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:id="@+id/cameraIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="50dp"
            android:contentDescription="@string/CamIco"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="#000000" />

        <Button
            android:id="@+id/scanBtn"
            android:text="@string/Scan"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3B82F6"
            android:paddingVertical="14dp"
            android:paddingHorizontal="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cornerRadius="8dp"/>

        <Button
            android:id="@+id/logoutBtn"
            android:text="@string/deauth"
            android:textSize="14sp"
            android:textColor="#EF4444"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- ЭКРАН АРХИВА (ПО УМОЛЧАНИЮ СКРЫТ) -->
    <FrameLayout
        android:id="@+id/archiveContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation"
        android:layout_alignParentTop="true"
        android:visibility="gone"
        android:padding="16dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/archiveRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- НИЖНЯЯ ПАНЕЛЬ НАВИГАЦИИ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:itemIconTint="#000000"
        app:itemTextColor="#000000"
        app:elevation="8dp"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
