<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:gravity="center"
    android:padding="20dp">

    <TextView
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/app_name"
        android:textColor="#1F1F1F"
        android:textSize="64sp"
        android:textStyle="bold"
        tools:ignore="TextSizeCheck" />

    <TextView
        android:layout_width="210dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="33dp"
        android:text="@string/tvoypo"
        android:textColor="#1F1F1F"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:ignore="TextSizeCheck" />
        <!-- Email -->
    <EditText
        android:id="@+id/userEmailLogin"
        android:layout_width="350dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:autofillHints="emailAddress"
        android:background="@drawable/fr_glass"
        android:textColor="#000000"
        android:textColorHint="#666666"
        android:cursorVisible="true"
        android:layout_gravity="center"
        android:textCursorDrawable="@drawable/cursor_black"
        android:hint="@string/userEmailHint"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="20dp" />

    <EditText
        android:id="@+id/userPasswordLogin"
        android:layout_width="350dp"
        android:layout_height="48dp"
        android:autofillHints="password"
        android:background="@drawable/fr_glass"
        android:textColor="#000000"
        android:layout_gravity="center"
        android:textColorHint="#666666"
        android:cursorVisible="true"
        android:textCursorDrawable="@drawable/cursor_black"
        android:hint="@string/userPasswordHint"
        android:inputType="textPassword"
        android:paddingHorizontal="20dp" />

        <!-- Забыл пароль -->
        <TextView
            android:id="@+id/forgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/forgotPassword"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="110dp"
            android:layout_gravity="center"/>

        <!-- Кнопка входа -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonLogin"
        android:layout_width="350dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:text="@string/login"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:backgroundTint="#000000"
        app:cornerRadius="12dp"
        tools:ignore="VisualLintButtonSize" />
    <TextView
        android:id="@+id/linkToReg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/toRegister"
        android:textSize="16sp"
        android:textColor="#000000"
        android:layout_marginTop="20dp"
        android:textStyle="bold"/>
        <!-- Разделитель -->
        <LinearLayout
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#DDD"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:text="@string/orSlash"
                android:textColor="#546E7A" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#DDD"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleAuth"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="350dp"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/loginGoogle"
            android:textAllCaps="false"
            android:textColor="#1F1F1F"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            app:backgroundTint="@android:color/white"
            tools:ignore="VisualLintButtonSize" />
         </LinearLayout>